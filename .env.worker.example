DATABASE_URL=postgres://radar:radar_dev_password@localhost:5432/radar_construjota
SCHEDULE_TIMEZONE=America/Sao_Paulo

COFEMA_LOGIN=
COFEMA_PASSWORD=
# O login sempre ocorre na origem abaixo. COFEMA_LOGIN_URL aceita caminho relativo.
COFEMA_BASE_URL=https://novo.cofema.com.br
COFEMA_LOGIN_URL=/
# Opcional. Vazio mantem a unidade ativa da conta; exemplos: Sao Paulo ou Sumare.
COFEMA_UNIDADE=
# Intervalo entre navegacoes de produto e novas tentativas HTTP na mesma sessao.
WORKER_COFEMA_PRODUCT_INTERVAL_MS=6500
WORKER_COFEMA_HTTP_RETRIES=2
WORKER_COFEMA_HTTP_RETRY_DELAY_MS=15000
CONSTRUJA_LOGIN=
CONSTRUJA_PASSWORD=
MAREST_LOGIN=
MAREST_PASSWORD=
MEGALESTE_LOGIN=
MEGALESTE_PASSWORD=

# Portal proprio da ConstruJota na Mercos. Nao confundir com CONSTRUJA.
CONSTRUJOTA_MERCOS_LOGIN=
CONSTRUJOTA_MERCOS_PASSWORD=
CONSTRUJOTA_MERCOS_BASE_URL=https://construjota2.mercos.com
# Intervalo conservador entre produtos. A agenda pode sobrescrever este valor.
CONSTRUJOTA_MERCOS_PRODUCT_INTERVAL_MS=4000
